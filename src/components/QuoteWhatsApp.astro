<section class="quote section" id="cotizar" aria-labelledby="quote-title">
  <div class="container quote-layout">
    <div class="quote-intro" data-reveal>
      <p class="eyebrow"><span></span> Cotización por WhatsApp</p>
      <h2 id="quote-title">Traza tu próxima ruta.</h2>
      <p>Completa los datos básicos. Al continuar, abriremos WhatsApp con tu solicitud ordenada y lista para enviar.</p>
      <ol class="quote-steps" aria-label="Proceso de cotización">
        <li><span>1</span><p><strong>Define la ruta</strong><small>Origen y destino.</small></p></li>
        <li><span>2</span><p><strong>Elige el servicio</strong><small>Flete o tipo de mudanza.</small></p></li>
        <li><span>3</span><p><strong>Envía por WhatsApp</strong><small>Recibe atención directa.</small></p></li>
      </ol>
    </div>

    <div class="quote-panel" data-reveal>
      <div class="quote-panel-top">
        <span>Solicitud de ruta</span>
        <span class="secure-note"><i></i> Sin registro</span>
      </div>
      <form class="quote-form" data-quote-form novalidate>
        <div class="form-error-summary" role="alert" aria-live="polite" tabindex="-1" data-error-summary hidden></div>

        <div class="field-grid">
          <div class="field">
            <label for="origen">Origen <span aria-hidden="true">*</span></label>
            <input id="origen" name="origen" type="text" autocomplete="street-address" placeholder="¿Desde dónde sales?" required aria-describedby="origen-error" />
            <p class="field-error" id="origen-error" data-error-for="origen"></p>
          </div>
          <div class="route-connector" aria-hidden="true"><span></span></div>
          <div class="field">
            <label for="destino">Destino <span aria-hidden="true">*</span></label>
            <input id="destino" name="destino" type="text" autocomplete="off" placeholder="¿A dónde necesitas llegar?" required aria-describedby="destino-error" />
            <p class="field-error" id="destino-error" data-error-for="destino"></p>
          </div>
        </div>

        <div class="field-grid field-grid-even">
          <div class="field">
            <label for="fecha">Fecha aproximada <span class="optional">Opcional</span></label>
            <input id="fecha" name="fecha" type="date" aria-describedby="fecha-hint" />
            <p class="field-hint" id="fecha-hint">Puedes confirmarla después.</p>
          </div>
          <div class="field">
            <label for="servicio">Tipo de servicio <span aria-hidden="true">*</span></label>
            <select id="servicio" name="servicio" required aria-describedby="servicio-error">
              <option value="">Selecciona una opción</option>
              <option value="Flete">Flete</option>
              <option value="Mudanza residencial">Mudanza residencial</option>
              <option value="Mudanza comercial">Mudanza comercial</option>
            </select>
            <p class="field-error" id="servicio-error" data-error-for="servicio"></p>
          </div>
        </div>

        <div class="field">
          <label for="observaciones">Observaciones <span class="optional">Opcional</span></label>
          <textarea id="observaciones" name="observaciones" rows="4" placeholder="Cuéntanos qué necesitas trasladar o cualquier detalle útil"></textarea>
        </div>

        <button class="button button-whatsapp" type="submit">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.4-4.4a8.4 8.4 0 1 1 15.6-4.4Z"/><path d="M8.1 7.7c.2-.5.5-.5.8-.5h.4c.1 0 .3 0 .4.3l.7 1.7c.1.2.1.4 0 .5l-.6.8c-.1.2-.2.3 0 .5.6 1.1 1.4 1.9 2.5 2.5.2.1.4.1.5-.1l.8-1c.2-.2.3-.2.5-.1l1.7.8c.2.1.4.2.4.4 0 .2-.1 1.2-.6 1.7-.4.5-1.2.8-1.8.8-.5 0-1.2-.2-2.1-.6-1.1-.5-4.3-2.2-5.5-5.2-.3-.8-.3-1.6 0-2.5Z"/></svg>
          Solicitar cotización por WhatsApp
          <span aria-hidden="true">→</span>
        </button>
        <p class="privacy-note">Tus datos no se guardan en este sitio. Se usan únicamente para preparar el mensaje que tú decides enviar.</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { buildWhatsAppUrl } from '../scripts/quote-message.mjs';

  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  const summary = document.querySelector<HTMLElement>('[data-error-summary]');
  const serviceLinks = document.querySelectorAll<HTMLAnchorElement>('[data-service]');

  serviceLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#servicio');
      if (select) select.value = link.dataset.service ?? '';
    });
  });

  const errorMessages: Record<string, string> = {
    origen: 'Escribe el lugar de origen.',
    destino: 'Escribe el lugar de destino.',
    servicio: 'Selecciona el tipo de servicio.',
  };

  const clearError = (field: HTMLInputElement | HTMLSelectElement) => {
    field.removeAttribute('aria-invalid');
    const error = document.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);
    if (error) error.textContent = '';
  };

  ['origen', 'destino', 'servicio'].forEach((name) => {
    const field = form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
    field?.addEventListener('input', () => {
      if (field.value.trim()) clearError(field);
    });
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const required = ['origen', 'destino', 'servicio'];
    const invalid: (HTMLInputElement | HTMLSelectElement)[] = [];

    required.forEach((name) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
      clearError(field);
      if (!String(data.get(name) ?? '').trim()) {
        field.setAttribute('aria-invalid', 'true');
        const error = document.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (error) error.textContent = errorMessages[name];
        invalid.push(field);
      }
    });

    if (invalid.length) {
      if (summary) {
        summary.textContent = 'Revisa los campos marcados para continuar.';
        summary.hidden = false;
        summary.focus();
      }
      invalid[0].focus();
      return;
    }

    if (summary) {
      summary.hidden = true;
      summary.textContent = '';
    }

    const value = (name: string) => String(data.get(name) ?? '').trim();
    const whatsappUrl = buildWhatsAppUrl({
      origin: value('origen'),
      destination: value('destino'),
      date: value('fecha'),
      service: value('servicio'),
      notes: value('observaciones'),
    });
    window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
  });
</script>
